# Copy to .env (setup.bat does this for you) and fill in.
PORT=8080
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=r1mc_leave
# Long random string. setup.bat generates one.
JWT_SECRET=
SESSION_HOURS=10
MAX_UPLOAD_MB=10

# Optional email notifications. Leave SMTP_HOST empty for in-app notifications only.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=R1MC Leave System <no-reply@r1mc.local>
APP_URL=
